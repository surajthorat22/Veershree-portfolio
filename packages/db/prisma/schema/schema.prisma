generator client {
  provider      = "prisma-client"
  output        = "../generated"
  moduleFormat  = "esm"
  runtime       = "nodejs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  Open
  FewLeft
  SoldOut
  ComingSoon
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  slug        String        @unique
  name        String
  location    String
  tagline     String        @default("")
  description String        @default("")
  features    String[]      @default([])
  image       String        @default("")
  priceFrom   String        @default("")
  size        String        @default("")
  status      ProjectStatus @default(Open)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  mobile    String
  location  String?
  message   String?
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  visitorId String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([path, createdAt])
}
