meta {
  name: Update Project
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/projects/:slug
  body: json
  auth: none
}

body:json {
  {
    "name": "Green Valley Estate",
    "location": "Pune, Maharashtra",
    "tagline": "Updated tagline",
    "status": "Few Left"
  }
}

params:path {
  slug: {{projectSlug}}
}

headers {
  Authorization: Bearer {{adminToken}}
}
